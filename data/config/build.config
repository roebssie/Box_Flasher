# Build Configuration
# Sourced by scripts/load_config.sh

## Cross-Compilation Settings
CMAKE_SYSTEM_NAME=Linux
CMAKE_SYSTEM_PROCESSOR=aarch64
CMAKE_CROSSCOMPILING=TRUE
CMAKE_TRY_COMPILE_TARGET_TYPE=EXECUTABLE

## Compiler Configuration
# Toolchain triple auto-detected by CMakeToolchain.cmake:
# - aarch64-unknown-linux-gnu (Homebrew messense tap - macOS)
# - aarch64-linux-gnu (apt - Linux/WSL)
# - aarch64-none-linux-gnu (Arm GNU Toolchain - Windows)
COMPILER_PREFIX=aarch64-unknown-linux-gnu
COMPILER_GCC_VERSION=13.3.0
CMAKE_CXX_STANDARD=17
CMAKE_CXX_STANDARD_REQUIRED=ON

## Build Directories (matches copilot-instructions.md)
BUILD_DIR=build-aarch64
OUTPUT_BINARY=monitor_service
BINARY_INSTALL_PATH=/opt/monitor_service

## Compiler Flags (non-architecture flags - arch flags in toolchain)
CMAKE_CXX_FLAGS=-Wall -Wextra -Wpedantic -O2
# Architecture flags are in CMakeToolchain.cmake, not here
CMAKE_ARCH_FLAGS=-march=armv8-a -mtune=cortex-a53

## Linker Configuration (static linking via target_link_options)
STATIC_LINKING=YES
LINK_FLAGS=-static -Wl,--as-needed
STATIC_LIBGCC=yes
STATIC_LIBSTDCXX=yes

## Build Options
ENABLE_DEBUG_SYMBOLS=yes
ENABLE_OPTIMIZATIONS=yes
OPTIMIZATION_LEVEL=O2
STRIP_BINARY=no
CREATE_SHARED_LIBS=no

## CMake Version
CMAKE_MIN_VERSION=3.10
CMAKE_VERSION_RECOMMENDED=3.24+

## Toolchain File
TOOLCHAIN_FILE=CMakeToolchain.cmake
TOOLCHAIN_PATH_PRIMARY=/opt/homebrew/bin
TOOLCHAIN_PATH_FALLBACK=/usr/local/bin

## Build Verification
VERIFY_STATIC_LINKING=yes
VERIFY_ARCHITECTURE=yes
VERIFY_SIZE_LIMIT=10M
VERIFY_DEPENDENCIES=yes

## Build Artifacts
BUILD_ARTIFACT_DIR=build-aarch64
BINARY_SIZE_WARNING=8M
BINARY_SIZE_ERROR=10M

## Cleanup Options
CLEAN_BUILD_BEFORE=no
CLEAN_CACHE_AFTER=yes
REMOVE_BUILD_ARTIFACTS=no
