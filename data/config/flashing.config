# Flashing Configuration

## Image Configuration
IMAGE_SOURCE_URL=https://github.com/ophub/amlogic-s9xxx-armbian/releases/download/Armbian_bullseye_arm64_server_2025.11/Armbian_25.11.0_amlogic_s905w_bullseye_6.1.158_server_2025.11.11.img.gz
IMAGE_FILENAME=Armbian_25.11.0_amlogic_s905w_bullseye_6.1.158_server_2025.11.11.img
IMAGE_COMPRESSED_FILENAME=Armbian_25.11.0_amlogic_s905w_bullseye_6.1.158_server_2025.11.11.img.gz
IMAGE_STORAGE_PATH=data/images
IMAGE_CACHE_PATH=data/cache/downloaded
IMAGE_SIZE_EXPECTED=2G
IMAGE_FILESYSTEM=ext4

## Flashing Tool Configuration
FLASHING_TOOL_TYPE=aml_usb_flashing_tool
FLASHING_TOOL_PATH=/usr/local/bin
FLASHING_TOOL_HOMEBREW_TAP=messense/amlogic-tools
FLASHING_TOOL_FALLBACK_METHOD=dd

## USB Configuration
USB_DETECTION_METHOD=system_profiler
USB_VENDOR_ID=0x1b8e
USB_DEVICE_CLASS=255
USB_RETRY_ATTEMPTS=3
USB_RETRY_DELAY=2

## Flashing Parameters
FLASHING_BLOCK_SIZE=4m
FLASHING_TIMEOUT_SECONDS=300
FLASHING_PROGRESS_INDICATOR=yes
FLASHING_SAFE_MODE=yes

## Boot Mode Configuration
BOOT_MODE_ENTRY="USB_FLASHING"
BOOT_BUTTON_HOLD_TIME=15
BOOT_BUTTON_LOCATION="Near USB Port"
JUMPER_MODE_ALTERNATIVE=yes
JUMPER_NAME="NAND_BOOT"

## Device Preparation
PRE_FLASHING_POWEROFF=yes
PRE_FLASHING_DISCONNECT=yes
POST_FLASHING_EJECT=yes
POWER_SUPPLY_CHECK=yes

## Verification
VERIFY_IMAGE_AFTER_DOWNLOAD=yes
VERIFY_FLASHING_COMPLETE=yes
VERIFY_DEVICE_BOOT=yes
BOOT_TIMEOUT_AFTER_FLASH=180

## Post-Flash Configuration
WAIT_FOR_BOOT_SECONDS=180
NETWORK_DISCOVERY_METHOD=mDNS
DEVICE_HOSTNAME_EXPECTED=armbian
DEVICE_IP_RANGE=192.168.1.0/24

## Logging
LOG_FILE_PATH=data/logs/flashing.log
LOG_VERBOSE=yes
LOG_TIMESTAMP=yes
LOG_LEVEL=INFO

## Backup Configuration
CREATE_BACKUP_BEFORE_FLASH=no
BACKUP_STORAGE_PATH=data/cache/backups
BACKUP_RETENTION_DAYS=30
