# Flashing Configuration
# Sourced by scripts/load_config.sh
#
# ⚠️ IMPORTANT: Two Different Image Types for S905W
# ════════════════════════════════════════════════════════════════════════════
#
# 1. ARMBIAN/LINUX IMAGES (this project uses these):
#    - Format: Raw disk image (.img)
#    - Flash method: SD card/USB drive using dd, balenaEtcher, or Rufus
#    - Boot: Insert SD card, hold reset button, power on
#    - Files: Armbian_*.img.gz from ophub/amlogic-s9xxx-armbian
#
# 2. AMLOGIC USB BURNING TOOL IMAGES (NOT supported by this project):
#    - Format: Amlogic-packed firmware (special .img format)
#    - Flash method: USB A-to-A cable + Amlogic USB Burning Tool (Windows)
#    - Source: Android TV box vendor firmware, LibreELEC burn images
#    - These images have a specific header structure for USB burning
#
# The Amlogic USB Burning Tool will show "Check Image failed!" if you try
# to load a raw Armbian .img file - they are NOT compatible!
#
# ⚠️ Image URL Versioning: Update IMAGE_SOURCE_URL, IMAGE_FILENAME, and
# IMAGE_COMPRESSED_FILENAME when newer S905W releases are needed.
# ════════════════════════════════════════════════════════════════════════════

## Image Configuration (Armbian_25.11.0_amlogic_s905w_bookworm_6.12.59 - December 2025)
## These are RAW DISK IMAGES - write to SD card, NOT for USB Burning Tool
IMAGE_SOURCE_URL=https://github.com/ophub/amlogic-s9xxx-armbian/releases/download/Armbian_bookworm_arm64_server_2025.12/Armbian_25.11.0_amlogic_s905w_bookworm_6.12.59_server_2025.12.01.img.gz
IMAGE_FILENAME=Armbian_25.11.0_amlogic_s905w_bookworm_6.12.59_server_2025.12.01.img
IMAGE_COMPRESSED_FILENAME=Armbian_25.11.0_amlogic_s905w_bookworm_6.12.59_server_2025.12.01.img.gz
IMAGE_SHA256=0ffd2a573d2298c4dfae22ffee9d940560d696cf0a59145d49daba5dd44fb435
IMAGE_SIZE_COMPRESSED=751M
IMAGE_STORAGE_PATH=data/images
IMAGE_CACHE_PATH=data/cache/downloaded
IMAGE_SIZE_EXPECTED=2G
IMAGE_FILESYSTEM=ext4

## Flashing Tool Configuration
# USB A-to-A Direct Flashing (NOT SD card/USB drive)
# Flashes directly to S905W's internal eMMC via USB A-to-A cable
FLASHING_TOOL_TYPE=aml_usb_flashing_tool
FLASHING_TOOL_PATH=/usr/local/bin
FLASHING_TOOL_HOMEBREW_TAP=messense/amlogic-tools
FLASHING_TOOL_FALLBACK_METHOD=dd

## Cross-platform flashing tools:
# macOS: usb_flash_s905w.sh uses aml_usb_flashing_tool (Homebrew: messense/amlogic-tools)
# Windows: Official Amlogic USB Burning Tool (GUI, most reliable)
# Linux: aml_usb_flashing_tool or pyamlboot for direct USB flashing

## USB Configuration
USB_DETECTION_METHOD=system_profiler
USB_VENDOR_ID=0x1b8e
USB_DEVICE_CLASS=255
USB_RETRY_ATTEMPTS=3
USB_RETRY_DELAY=2

## Flashing Parameters
FLASHING_BLOCK_SIZE=4m
FLASHING_TIMEOUT_SECONDS=300
FLASHING_PROGRESS_INDICATOR=yes
FLASHING_SAFE_MODE=yes

## Boot Mode Configuration
BOOT_MODE_ENTRY="USB_FLASHING"
BOOT_BUTTON_HOLD_TIME=15
BOOT_BUTTON_LOCATION="Near USB Port"
JUMPER_MODE_ALTERNATIVE=yes
JUMPER_NAME="NAND_BOOT"

## Device Preparation
PRE_FLASHING_POWEROFF=yes
PRE_FLASHING_DISCONNECT=yes
POST_FLASHING_EJECT=yes
POWER_SUPPLY_CHECK=yes

## Verification
VERIFY_IMAGE_AFTER_DOWNLOAD=yes
VERIFY_FLASHING_COMPLETE=yes
VERIFY_DEVICE_BOOT=yes
BOOT_TIMEOUT_AFTER_FLASH=180

## Post-Flash Configuration
WAIT_FOR_BOOT_SECONDS=180
NETWORK_DISCOVERY_METHOD=mDNS
DEVICE_HOSTNAME_EXPECTED=armbian
DEVICE_IP_RANGE=192.168.1.0/24

## Logging
LOG_FILE_PATH=data/logs/flashing.log
LOG_VERBOSE=yes
LOG_TIMESTAMP=yes
LOG_LEVEL=INFO

## Backup Configuration
CREATE_BACKUP_BEFORE_FLASH=no
BACKUP_STORAGE_PATH=data/cache/backups
BACKUP_RETENTION_DAYS=30
