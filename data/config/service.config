# Service Configuration
# Sourced by scripts/load_config.sh

## Service Identity
SERVICE_NAME=monitor
SERVICE_DESCRIPTION=Amlogic S905W System Monitoring Service
SERVICE_DOCUMENTATION=file:///opt/monitor_service

## Service File
SERVICE_FILE_PATH=/etc/systemd/system/monitor.service
SERVICE_FILE_REMOTE_INSTALL_PATH=/tmp/monitor.service

## Binary Configuration (matches copilot-instructions.md)
BINARY_PATH=/opt/monitor_service
BINARY_SOURCE_PATH=build-aarch64/monitor_service
BINARY_TRANSFER_METHOD=scp
BINARY_PERMISSIONS=755

## Systemd Configuration
SERVICE_TYPE=oneshot
SERVICE_USER=root
SERVICE_GROUP=root
SERVICE_RESTART_POLICY=no
SERVICE_RESTART_SEC=1s

## Start Configuration
START_ON_BOOT=yes
START_TARGET=multi-user.target
START_AFTER=network-online.target
START_WANTS=network-online.target
START_CONDITION=no

## Output Configuration
STDOUT_METHOD=journal
STDERR_METHOD=journal
SYSLOG_IDENTIFIER=monitor
LOG_LEVEL=INFO

## Process Configuration
ENVIRONMENT_VARIABLES=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKING_DIRECTORY=/opt
UMASK=0022
NICE_PRIORITY=0
LIMIT_NOFILE=1024
LIMIT_NPROC=512

## Monitoring Configuration (paths match device.config)
MONITORING_INTERVAL_SECONDS=1
CPU_TEMP_SOURCE=/sys/class/thermal/thermal_zone0/temp
MEMORY_INFO_SOURCE=/proc/meminfo
MOUNT_INFO_SOURCE=/proc/mounts
# Pseudo-fs filter list (must match main.cpp get_storage_health())
STORAGE_FILTER_TYPES=tmpfs,sysfs,proc,devtmpfs,devpts,cgroup,cgroup2

## Output Format
OUTPUT_FORMAT=text
OUTPUT_PRECISION=2
OUTPUT_UNITS_TEMPERATURE=Celsius
OUTPUT_UNITS_MEMORY=MB
OUTPUT_UNITS_STORAGE=GB

## Deployment Configuration (SSH settings for setup_device.sh)
SSH_USER=root
SSH_PORT=22
SSH_KEY_AUTH=yes
SSH_PASSWORD_AUTH=no
SSH_TIMEOUT_SECONDS=5

## Service Management Commands
SERVICE_START_CMD=systemctl start monitor.service
SERVICE_STOP_CMD=systemctl stop monitor.service
SERVICE_RESTART_CMD=systemctl restart monitor.service
SERVICE_STATUS_CMD=systemctl status monitor.service
SERVICE_ENABLE_CMD=systemctl enable monitor.service
SERVICE_DISABLE_CMD=systemctl disable monitor.service

## Logging
SERVICE_LOG_PATH=/var/log/monitor.log
SERVICE_LOG_RETENTION=30
SERVICE_LOG_LEVEL=INFO
SERVICE_JOURNAL_QUERY=journalctl -u monitor.service -f

## Auto-Restart
AUTO_RESTART_ON_FAILURE=no
AUTO_RESTART_DELAY=60
CRASH_REPORT=yes
CRASH_LOG_PATH=data/logs/crashes

## Cleanup
CLEANUP_ON_DISABLE=no
REMOVE_LOG_ON_UNINSTALL=yes
BACKUP_CONFIG_ON_UPDATE=yes
