# Device Configuration for Amlogic S905W
# Sourced by scripts/load_config.sh

## Device Information
DEVICE_NAME=Amlogic-S905W
DEVICE_ARCH=aarch64
DEVICE_ARCH_VARIANT=armv8-a
DEVICE_PLATFORM=Amlogic-S905W
DEVICE_SOC=S905W

## USB Configuration (for USB A-to-A Direct Flashing)
USB_VENDOR_ID=0x1b8e
USB_PRODUCT_ID=0xc003
USB_DEVICE_CLASS=255
USB_DEVICE_SUBCLASS=0x50
USB_DEVICE_PROTOCOL=0x01

## Network Configuration
DEVICE_HOSTNAME=armbian
DEVICE_USERNAME=root
DEVICE_PASSWORD_DEFAULT=

## File System Configuration
DEVICE_ROOT_PARTITION=/dev/mmcblk0p2
DEVICE_BOOT_PARTITION=/dev/mmcblk0p1
DEVICE_STORAGE_MOUNT=/mnt/storage
DEVICE_CACHE_MOUNT=/mnt/cache

## System Monitoring Points (used by monitor_service C++ binary)
THERMAL_ZONE_PATH=/sys/class/thermal/thermal_zone0/temp
MEMINFO_PATH=/proc/meminfo
MOUNTS_PATH=/proc/mounts
CPU_INFO_PATH=/proc/cpuinfo

## Operating System
OS_TYPE=Armbian
OS_ARCH=aarch64
OS_VERSION_LATEST=25.11.0
OS_PACKAGE_URL=https://github.com/ophub/amlogic-s9xxx-armbian/releases

## Boot Configuration
BOOT_MODE=USB
BOOT_TIMEOUT_SECONDS=30
BOOT_LED_INDICATOR=yes
BOOT_SERIAL_DEBUG=no

## Power Configuration
POWER_SUPPLY_MIN=5V
POWER_SUPPLY_MIN_AMPERAGE=2.0A
POWER_JACK_TYPE=Barrel-5.5x2.1mm

## Development Configuration
TOOLCHAIN_TARGET=aarch64-unknown-linux-gnu
CMAKE_SYSTEM_PROCESSOR=aarch64
BUILD_ARCH=aarch64
HOST_ARCH=arm64
CROSS_COMPILE_HOST=macOS

## Service Configuration
SERVICE_NAME=monitor
SERVICE_BINARY=/opt/monitor_service
SERVICE_TYPE=oneshot
SERVICE_START_ON_BOOT=yes
SERVICE_RESTART_POLICY=no

## Logging
LOG_LEVEL=INFO
LOG_OUTPUT=journal
LOG_MAX_SIZE=10M
LOG_RETENTION_DAYS=30
